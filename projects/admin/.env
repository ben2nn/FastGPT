# token
TOKEN_KEY=dfdasfdas

# mongo 数据库连接参数，本地开发连接远程数据库时，可能需要增加 directConnection=true 参数，才能连接上。
MONGODB_URI=mongodb://dejax:dejax1234@192.168.33.72:27017/fastgpt?authSource=admin&directConnection=true

DCE_HAPPY=dejaxshigekuailedeqingnian
# 日志等级: debug, info, warn, error
LOG_LEVEL=debug

ALLOWED_ORIGINS=

# ==================== 数据提取系统配置 ====================
# 
# 数据提取系统用于从 MongoDB 中提取大模型调用记录，并存储到 PostgreSQL 数据库中
# 系统通过定时任务每天自动提取前一天的数据，也支持通过 API 手动触发
#
# 功能说明：
# - 自动提取 chatitems 集合中的 AI 消息和模型调用记录
# - 关联 apps 和 chat 集合获取完整的上下文信息
# - 验证数据完整性和准确性
# - 批量插入到 PostgreSQL 进行持久化存储
# - 提供 API 端点用于手动触发、状态查询和健康检查
#
# 部署前准备：
# 1. 确保 PostgreSQL 数据库已安装并运行
# 2. 运行初始化脚本创建数据表: node scripts/init-postgres-tables.js
# 3. 配置下方的环境变量
# 4. 启动服务后，系统会自动初始化并开始定时任务
# ============================================================

# ---------- PostgreSQL 数据库配置 ----------
# 
# PostgreSQL 连接字符串
# 格式: postgresql://[用户名]:[密码]@[主机]:[端口]/[数据库名]
# 示例: postgresql://postgres:mypassword@localhost:5432/fastgpt_analytics
# 
# 注意事项：
# - 确保数据库已创建（数据库名建议使用 fastgpt_analytics）
# - 用户需要有创建表和索引的权限
# - 生产环境建议使用强密码并限制访问 IP
PG_URL=postgresql://dejax:dejax1234@192.168.33.72:5432/postgres

# PostgreSQL 连接池最大连接数
# 默认值: 10
# 说明: 根据服务器性能和并发需求调整，建议范围 5-20
# 注意: 连接数过多会占用数据库资源，过少可能影响性能
POSTGRES_MAX_CONNECTIONS=10

# ---------- 定时任务配置 ----------
#
# Cron 表达式，用于配置定时任务的执行时间
# 格式: [分] [时] [日] [月] [周]
# 默认值: 0 1 * * * (每天凌晨 1:00 执行)
# 
# 常用示例：
# - '0 1 * * *'   每天凌晨 1:00
# - '0 2 * * *'   每天凌晨 2:00
# - '0 */6 * * *' 每 6 小时执行一次
# - '0 0 * * 0'   每周日凌晨 0:00
# 
# 说明: 定时任务会自动提取前一天（00:00:00 到 23:59:59）的数据
CRON_EXPRESSION=0 1 * * *

# 是否启用定时任务
# 可选值: true | false
# 默认值: true
# 说明: 
# - 设置为 false 可以禁用自动定时任务
# - 禁用后仍可通过 API 手动触发数据提取
# - 开发环境建议设置为 false，避免频繁执行
CRON_ENABLED=true

# ---------- 数据提取参数配置 ----------
#
# 每批处理的记录数量
# 默认值: 1000
# 说明: 
# - 从 MongoDB 提取数据时，每批读取的记录数
# - 较大的批次可以提高性能，但会占用更多内存
# - 建议范围: 500-2000，根据服务器内存调整
EXTRACTION_BATCH_SIZE=1000

# 数据库连接失败时的重试次数
# 默认值: 3
# 说明: 
# - 当 MongoDB 或 PostgreSQL 连接失败时，系统会自动重试
# - 设置为 0 表示不重试
# - 建议范围: 2-5
EXTRACTION_RETRY_ATTEMPTS=3

# 重试间隔时间（毫秒）
# 默认值: 5000 (5秒)
# 说明: 
# - 两次重试之间的等待时间
# - 建议范围: 3000-10000 (3-10秒)
EXTRACTION_RETRY_DELAY=5000

# ---------- 可选配置 ----------
#
# 是否启用数据提取服务（仅开发环境使用）
# 可选值: true | false
# 默认值: false (开发环境), true (生产环境)
# 说明: 
# - 开发环境默认禁用，避免影响本地开发
# - 生产环境会自动启用，无需配置此项
# - 如需在开发环境测试，可设置为 true
# ENABLE_DATA_EXTRACTION=false

# AI Proxy PostgreSQL 数据库连接（用于渠道导入导出直接操作数据库）
AIPROXY_PG_URL=postgres://dejax:dejax1234@192.168.33.72:5433/aiproxy
